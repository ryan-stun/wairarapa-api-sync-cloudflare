{
  "name": "wairarapa-api-sync",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "npm run deploy:cloudflare",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy:shopify": "shopify app deploy",
    "d1:migrate:local": "wrangler d1 migrations apply wairarapa-api-sync-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply wairarapa-api-sync-db --remote"
  },
  "type": "module",
  "dependencies": {
    "@remix-run/dev": "2.17.5",
    "@remix-run/react": "2.17.5",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-api": "^9.2.0",
    "@shopify/shopify-app-remix": "^3.5.1",
    "fuse.js": "^7.0.0",
    "he": "^1.2.0",
    "isbot": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite-tsconfig-paths": "^4.3.1",
    "@remix-run/cloudflare": "2.17.5"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.7.1",
    "@shopify/api-codegen-preset": "^0.0.3",
    "@shopify/app-bridge-types": "^0.0.7",
    "@types/eslint": "^8.40.0",
    "@types/node": "^20.6.3",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.3",
    "wrangler": "3.114.17",
    "@cloudflare/workers-types": "4.20260702.1"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "author": "stunmacbook"
}
